// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}


enum SectorType {
  PRIVATE
  GOVERNMENT
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model User{
  id          Int         @id @default(autoincrement())
  username    String      @unique
  mobileno    String      @unique
  fullname    String
  is_active   Boolean     @default(true) 
  role      Role  

  corporations UserCorporation[]
  sites         UserSite[]
  created_at   DateTime    @default(now())

}

model OtpVerification {
  id         Int      @id @default(autoincrement())
  mobile     String
  otp        String
  created_at DateTime @default(now())
  expires_at DateTime
}

model Corporation{
  id                Int         @id @default(autoincrement())
  name              String      @unique
  aws_type          String
  gps_enabled       Boolean     @default(false)
  validation_mode   String
  profile_pic       String?
  created_at        DateTime

  users UserCorporation[]
  sites     Site[]
}

model UserCorporation {
  id                Int         @id @default(autoincrement())
  user_id            Int
  corporation_id     Int

  user              User        @relation(fields: [user_id], references: [id])
  corporation       Corporation @relation(fields: [corporation_id], references: [id])

  @@unique([user_id, corporation_id])
}


model Site {
  id             Int    @id @default(autoincrement())
  name           String
  awsType        String
  concept        String
  location       String?
  zone           String?
  ward           String?
  weighment_place String?
  ftp_image_prefix   String?

  corporation_id Int
  corporation   Corporation @relation(fields: [corporation_id], references: [id])

  users    UserSite[]
  device   SiteMetaData?
  images   SiteImage[]
  config   SiteConfigFile?
}


model UserSite {
  id        Int       @id @default(autoincrement())
  user_id    Int
  site_id    Int

  user      User      @relation(fields: [user_id], references: [id])
  site      Site      @relation(fields: [site_id], references: [id])

  @@unique([user_id, site_id])
}

model SiteMetaData {
  id                Int       @id @default(autoincrement())
  site_id           Int       @unique
  pc_serial_number  String?
  sim_network       String?
  sim_number        String?
  machine_reg_no    String?
  software_version  String?
  any_desk          String?

  site Site @relation(fields: [site_id], references: [id])
}

model SiteImage {
  id                Int    @id @default(autoincrement())
  site_id           Int
  image_path        String

  site Site @relation(fields: [site_id], references: [id])
}


model SiteConfigFile {
  id            Int     @id @default(autoincrement())
  site_id       Int     @unique
  path          String

  site          Site    @relation(fields: [site_id], references: [id])
}
