// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}


enum SectorType {
  PRIVATE
  GOVERNMENT
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  SUB_USER
}

enum AwsType {
  MEGA
  MINI
  MICRO
}

enum AwsConcept {
  IN
  IN_OUT
}

enum LocationSource {
  SITE
  VEHICLE
  TRIP
}

enum TripStatus {
  OPEN
  CLOSED
  ABNORMAL_IN
  ABNORMAL_OUT
}

model User{
  id          Int         @id @default(autoincrement())
  username    String      @unique
  mobileno    String      @unique
  fullname    String
  is_active   Boolean     @default(true) 
  role        Role  

  Organizations  UserOrganization[]
  sites         UserSite[]
  created_at   DateTime    @default(now())

}

model OtpVerification {
  id         Int      @id @default(autoincrement())
  mobile     String
  otp        String
  created_at DateTime @default(now())
  expires_at DateTime
}

model Organization{
  id                Int         @id @default(autoincrement())
  name              String      @unique
  gps_enabled       Boolean     @default(false)
  corp_aws_type     AwsType
  sector            SectorType
  location_source   LocationSource
  profile_pic       String?
  created_at        DateTime

  users UserOrganization[]
  vehicles VehicleOrganization[]

  sites     Site[]
  zone_groups  Group[]
  devices   Devices[]
 mega_trips MegaTrip[]
  micro_trips MicroTrip[]
}

model UserOrganization {
  id                 Int         @id @default(autoincrement())
  user_id            Int
  organization_id     Int

  user               User        @relation(fields: [user_id], references: [id])
  organization        Organization @relation(fields: [organization_id], references: [id])

  @@unique([user_id, organization_id])
}


model Site {
  id                Int    @id @default(autoincrement())
  name              String
  site_aws_type     AwsType
  concept           AwsConcept
  location          String?
  weighment_place   String?
  ftp_image_prefix  String?

  organization_id    Int
  organization       Organization @relation(fields: [organization_id], references: [id])

  users    UserSite[]
  other_details   SiteMetaData?
  images   SiteImage[]
  config   SiteConfigFile?
  mega_trips MegaTrip[]
  micro_trips MicroTrip[]
  devices   Devices[]
  @@unique([name, organization_id])
}


model UserSite {
  id                Int       @id @default(autoincrement())
  user_id           Int
  site_id           Int

  user              User      @relation(fields: [user_id], references: [id])
  site              Site      @relation(fields: [site_id], references: [id])

  @@unique([user_id, site_id])
}

model SiteMetaData {
  id                Int       @id @default(autoincrement())
  site_id           Int       @unique
  pc_serial_number  String?
  sim_network       String?
  sim_number        String?
  machine_reg_no    String?
  software_version  String?
  any_desk          String?

  site Site @relation(fields: [site_id], references: [id])
}

model SiteImage {
  id                Int    @id @default(autoincrement())
  site_id           Int
  image_path        String

  site Site @relation(fields: [site_id], references: [id])
}


model SiteConfigFile {
  id            Int     @id @default(autoincrement())
  site_id       Int     @unique
  path          String

  site          Site    @relation(fields: [site_id], references: [id])
}

model Group {
  id              Int      @id @default(autoincrement())
  name            String
  organization_id  Int

  organization     Organization @relation(fields: [organization_id], references: [id])
  subgroups       SubGroup[]

  @@unique([name, organization_id])
}
model SubGroup {
  id       Int @id @default(autoincrement())
  name     String
  group_id Int

  group    Group @relation(fields: [group_id], references: [id])

  vehicles  VehicleGroup[]

  @@unique([name, group_id])
}
model Vehicle {
  id          Int     @id @default(autoincrement())
  rf_id       String  @unique
  imei        String  @unique
  vehicle_no  String

  organizations VehicleOrganization[]
  mega_trips   MegaTrip[]
  micro_trips  MicroTrip[]
  groups       VehicleGroup[]
}

model VehicleGroup {
  id          Int @id @default(autoincrement())

  vehicle_id  Int
  subgroup_id Int

  vehicle     Vehicle  @relation(fields:[vehicle_id], references:[id])
  subgroup    SubGroup @relation(fields:[subgroup_id], references:[id])

  @@unique([vehicle_id, subgroup_id])
}

model VehicleOrganization {
  id               Int    @id @default(autoincrement())
  vehicle_id       Int
  organization_id   Int

  organization     Organization  @relation(fields: [organization_id], references: [id])
  vehicle         Vehicle @relation(fields: [vehicle_id], references: [id])

  @@unique([vehicle_id, organization_id])
}

model Devices {
  id              Int     @id @default(autoincrement())
  uuid            String     @unique
  name            String
  site_id         Int
  organization_id Int
  awstype         AwsType
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt  @default(now())

  site            Site    @relation(fields: [site_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])
}

model MegaLog {
  id          BigInt   @id @default(autoincrement())
  received_at DateTime
  payload     Json
  processed   Boolean  @default(false)
  created_at  DateTime @default(now())
}

model MegaTrip {
  id         BigInt   @id @default(autoincrement())

  organization_id Int 
  organization  Organization @relation(fields: [organization_id], references: [id]) 
  site_id    Int
  site       Site @relation(fields: [site_id], references: [id])

  zone_subgroup_id Int?
  ward_subgroup_id Int?

  vehicle_id Int?
  vehicle    Vehicle? @relation(fields: [vehicle_id], references: [id])

  weight_in  Int?
  date_in    DateTime?

  weight_out Int?
  date_out   DateTime?

  front_in   String?
  back_in    String?
  left_in    String?
  right_in   String?

  front_out  String?
  back_out   String?
  left_out   String?
  right_out  String?

  trip_no    Int?
  status     TripStatus

  created_at DateTime @default(now())

  @@index([site_id, date_in])
  @@index([vehicle_id])
}

model MicroLog {
  id          BigInt   @id @default(autoincrement())
  received_at DateTime
  payload     Json
  processed   Boolean  @default(false)
  created_at  DateTime @default(now())
}

model MicroTrip {
  id         BigInt   @id @default(autoincrement())

  organization_id Int 
  organization  Organization @relation(fields: [organization_id], references: [id]) 
  site_id    Int
  site       Site @relation(fields: [site_id], references: [id])

  zone_subgroup_id Int?
  ward_subgroup_id Int?

  vehicle_id Int?
  vehicle    Vehicle? @relation(fields: [vehicle_id], references: [id])

  timestamp  DateTime
  trip_no    Int

  created_at DateTime @default(now())

  readings   MicroReading[]

  @@index([site_id, timestamp])
  @@index([vehicle_id])
}

model MicroReading {
  id       BigInt @id @default(autoincrement())

  trip_id  BigInt
  trip     MicroTrip @relation(fields: [trip_id], references: [id])

  waste    String
  weight   Int

  image1   String?
  image2   String?
  image3   String?
  image4   String?
}

model Reports {
  id        Int       @id @default(autoincrement())
}